# PALISADE configuration. Copy to `.env` and edit; `.env` is gitignored.
#
# Every flag defaults off/minimal. With PALISADE_ENABLED unset the hook list
# is empty and a guarded agent is byte-identical to the unguarded baseline.

# --- master and per-gate toggles ------------------------------------------
PALISADE_ENABLED=false
PALISADE_G1_ENABLED=false   # prompt      (B1)
PALISADE_G2_ENABLED=false   # tool        (B2)
PALISADE_G3_ENABLED=false   # retrieval   (B3)
PALISADE_G4_ENABLED=false   # code        (B4)
PALISADE_G5_ENABLED=false   # scheduler   (B5)
PALISADE_G6_ENABLED=false   # egress      (B0)

# --- slow tier (the quarantined model) ------------------------------------
# Every fast-tier allow escalates to it, so benign escalation is 100% and the
# per-turn cost rises from 0.28 ms to ~2.5 s. The fast tier is the reported
# operating point.
PALISADE_QUARANTINE_ENABLED=false
PALISADE_QUARANTINE_MODEL=openai:gpt-oss-120b

# The endpoint must serve the model UNFILTERED. The safety-filtered variant
# refuses adversarial inputs and inflates the apparent block rate.
# A facility running the slow tier on live scientific data must satisfy the
# in-boundary enclave requirement first -- see REPRODUCING.md.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- G4 static analysis ----------------------------------------------------
# Runs the ruleset bundled under src/palisade/contracts/semgrep/, not one
# pinned to an upstream registry, so +semgrep needs no network.
PALISADE_SEMGREP_ENABLED=false

# --- trust scorer ----------------------------------------------------------
# A high-stakes denial ratchets a per-capability floor that later benign
# traffic cannot lift; only explicit re-authentication clears it. The
# recommended posture turns this OFF -- see the paper, Section V-F.
PALISADE_STICKY_HIGH_STAKES=true

# --- contracts and corpora -------------------------------------------------
PALISADE_CONTRACTS_DIR=palisade_contracts
PALISADE_KNOWLEDGE_BASES_DIR=knowledge_bases

# --- provenance ------------------------------------------------------------
# Without a broker, decisions are emitted as JSONL.
PALISADE_FLOWCEPT_ENABLED=false
PALISADE_FLOWCEPT_ENDPOINT=
