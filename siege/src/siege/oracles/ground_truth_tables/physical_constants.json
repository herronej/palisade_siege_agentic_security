    "avogadro":        {"value": 6.02214076e23,"unit": "1/mol",    "tol_pct": 1.0, "aliases": ["N_A", "NA", "avogadro_number"]},
    "faraday":         {"value": 96485.0,     "unit": "C/mol",     "tol_pct": 1.0, "aliases": ["F"]}
  },
  "absolute_bounds": {
